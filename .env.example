# Copy this file to .env and fill in your own values. Never commit .env.
# PayPal variable names are confirmed (T-003). AWS / Bedrock values are decided in ADR-003.

# PayPal SANDBOX app credentials (developer.paypal.com > Apps & Credentials > Sandbox).
# PAYPAL_BASE_URL is optional; any value other than the sandbox URL is refused.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# AWS / Amazon Bedrock (ADR-003). Model IDs are config, not code.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
# Secondary model, used for the T-007 comparison.
BEDROCK_MODEL_ID_SECONDARY=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Optional. AWS credentials come from the AWS CLI profile (standard boto3 credential
# chain), never from this file. Do not put AWS keys here.
AWS_PROFILE=default
